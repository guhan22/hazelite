# Used by docker-compose when the database volume is first created. Pick your own.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://hazelite:change-me@localhost:5432/hazelite

# Optional: data.gov.sg API key (raises rate limits). https://guide.data.gov.sg/developer-guide/api-overview
DATA_GOV_SG_API_KEY=

# How often the server polls NEA for new readings. 0 disables the in-app poller.
INGEST_INTERVAL_MINUTES=15

# Optional: NASA FIRMS key for the fire-hotspot card (free, emailed instantly). Without it the card is hidden.
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Optional: Web Push (VAPID) keys for haze alerts. Without them the alerts bell is hidden.
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Days of history to backfill on first start when the database is empty.
BACKFILL_DAYS_ON_EMPTY=7

# /api/ingest requires "Authorization: Bearer <secret>" matching CRON_SECRET (sent by Vercel Cron)
# or INGEST_TOKEN (for other schedulers, e.g. the hourly GitHub Actions workflow). Leave both empty to
# disable the endpoint.
# Generate one with: openssl rand -hex 32
CRON_SECRET=
INGEST_TOKEN=
